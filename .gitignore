node_modules/

# Output
.output
.vercel
.netlify
.wrangler
/.svelte-kit
/build

# Generated og:image cards (scripts/og.ts) — fully reproducible from character data,
# palette.ts and the bundled fonts. 48 binaries rewritten on every epithet reword would
# permanently bloat clone size, so these are build output, not source.
/static/og/

# OS
.DS_Store
Thumbs.db

# Python bytecode cache (Claude Code hooks)
__pycache__/
*.pyc

# Env
.env
.env.*
!.env.example
!.env.test
# .env itself is tracked: it holds only PUBLIC_SITE_ORIGIN, a public URL (see src/lib/site.ts).
# Anything with actual secrets goes in .env.local or similar, which stays ignored above.
!.env

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Claude Code local settings (machine-specific, never shared)
.claude/settings.local.json
